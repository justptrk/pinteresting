<div class="row" style="margin-bottom: 20px;">
  <div class="col-md-6">
    <h2><i class="fa fa-tasks"></i> Tasks
      <% if @overdue_count > 0 %>
        <span class="label label-danger"><%= @overdue_count %> Overdue</span>
      <% end %>
      <% if @today_count > 0 %>
        <span class="label label-warning"><%= @today_count %> Due Today</span>
      <% end %>
    </h2>
  </div>
  <div class="col-md-6 text-right" style="padding-top: 20px;">
    <%= link_to raw('<i class="fa fa-plus"></i> New Task'), new_task_path, class: 'btn btn-primary' %>
  </div>
</div>

<div class="btn-group" style="margin-bottom: 5px;">
  <%= link_to 'All', tasks_path, class: "btn btn-default btn-sm #{params[:status].blank? ? 'active' : ''}" %>
  <% Task::STATUSES.each do |s| %>
    <%= link_to s.titleize, tasks_path(status: s), class: "btn btn-default btn-sm #{params[:status] == s ? 'active' : ''}" %>
  <% end %>
</div>
<div class="btn-group" style="margin-bottom: 15px; margin-left: 10px;">
  <% Task::CATEGORIES.each do |cat| %>
    <%= link_to cat.titleize, tasks_path(category: cat), class: "btn btn-default btn-sm #{params[:category] == cat ? 'active' : ''}" %>
  <% end %>
</div>

<div class="table-responsive">
  <table class="table table-hover">
    <thead>
      <tr><th>Task</th><th>Client</th><th>Priority</th><th>Status</th><th>Category</th><th>Assigned To</th><th>Due Date</th><th></th></tr>
    </thead>
    <tbody>
      <% @tasks.each do |task| %>
        <tr class="<%= 'danger' if task.overdue? %>">
          <td><%= link_to task.title, task_path(task) %></td>
          <td><%= task.client&.company_name %></td>
          <td><span class="label label-<%= task.priority_color %>"><%= task.priority.titleize %></span></td>
          <td><%= status_badge(task.status, task.status_color) %></td>
          <td><%= task.category&.titleize %></td>
          <td><%= task.assigned_to&.full_name || 'Unassigned' %></td>
          <td class="<%= 'text-danger' if task.overdue? %>"><%= task.due_date&.strftime('%b %d, %Y') %></td>
          <td>
            <% unless task.status == 'completed' %>
              <%= link_to raw('<i class="fa fa-check"></i>'), complete_task_path(task), method: :patch, class: 'btn btn-xs btn-success', title: 'Complete' %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
