<%= form_for @task do |f| %>
  <% if @task.errors.any? %>
    <div class="alert alert-danger">
      <% @task.errors.full_messages.each do |msg| %><p><%= msg %></p><% end %>
    </div>
  <% end %>
  <div class="row">
    <div class="col-md-8"><div class="form-group"><label>Title *</label><%= f.text_field :title, class: 'form-control' %></div></div>
    <div class="col-md-4"><div class="form-group"><label>Category</label><%= f.select :category, Task::CATEGORIES.map { |c| [c.titleize, c] }, { include_blank: '-- Select --' }, class: 'form-control' %></div></div>
  </div>
  <div class="row">
    <div class="col-md-3"><div class="form-group"><label>Priority</label><%= f.select :priority, Task::PRIORITIES.map { |p| [p.titleize, p] }, {}, class: 'form-control' %></div></div>
    <div class="col-md-3"><div class="form-group"><label>Status</label><%= f.select :status, Task::STATUSES.map { |s| [s.titleize, s] }, {}, class: 'form-control' %></div></div>
    <div class="col-md-3"><div class="form-group"><label>Due Date</label><%= f.date_field :due_date, class: 'form-control' %></div></div>
    <div class="col-md-3"><div class="form-group"><label>Assigned To</label><%= f.collection_select :assigned_to_id, User.order(:first_name), :id, :full_name, { include_blank: '-- Select --' }, class: 'form-control' %></div></div>
  </div>
  <div class="row">
    <div class="col-md-4"><div class="form-group"><label>Client</label><%= f.collection_select :client_id, Client.order(:company_name), :id, :company_name, { include_blank: '-- Select --' }, class: 'form-control' %></div></div>
    <div class="col-md-4"><div class="form-group"><label>Campaign</label><%= f.collection_select :campaign_id, Campaign.order(:name), :id, :name, { include_blank: '-- Select --' }, class: 'form-control' %></div></div>
    <div class="col-md-2"><div class="form-group"><label>Est. Hours</label><%= f.number_field :estimated_hours, class: 'form-control' %></div></div>
    <div class="col-md-2"><div class="form-group"><label>Actual Hours</label><%= f.number_field :actual_hours, class: 'form-control' %></div></div>
  </div>
  <div class="form-group"><label>Description</label><%= f.text_area :description, class: 'form-control', rows: 4 %></div>
  <%= f.submit class: 'btn btn-primary' %>
  <%= link_to 'Cancel', tasks_path, class: 'btn btn-default' %>
<% end %>
