<div class="row">
  <div class="col-md-8">
    <h2><%= @task.title %>
      <span class="label label-<%= @task.priority_color %>"><%= @task.priority.titleize %></span>
      <%= status_badge(@task.status, @task.status_color) %>
    </h2>
    <p class="text-muted">
      <% if @task.client %> Client: <%= link_to @task.client.company_name, client_path(@task.client) %> |<% end %>
      Category: <strong><%= @task.category&.titleize %></strong> |
      Created by: <%= @task.created_by&.full_name %>
    </p>
  </div>
  <div class="col-md-4 text-right" style="padding-top: 20px;">
    <% unless @task.status == 'completed' %>
      <%= link_to raw('<i class="fa fa-check"></i> Complete'), complete_task_path(@task), method: :patch, class: 'btn btn-success' %>
    <% end %>
    <%= link_to raw('<i class="fa fa-edit"></i> Edit'), edit_task_path(@task), class: 'btn btn-default' %>
  </div>
</div>
<hr>

<div class="row">
  <div class="col-md-8">
    <div class="panel panel-default">
      <div class="panel-heading"><h4 style="margin:0;">Description</h4></div>
      <div class="panel-body">
        <%= simple_format(@task.description) if @task.description.present? %>
        <p class="text-muted" if @task.description.blank?>No description provided.</p>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="panel panel-default">
      <div class="panel-heading"><h4 style="margin:0;">Details</h4></div>
      <div class="panel-body">
        <p><strong>Assigned To:</strong> <%= @task.assigned_to&.full_name || 'Unassigned' %></p>
        <p><strong>Due Date:</strong>
          <span class="<%= 'text-danger' if @task.overdue? %>">
            <%= @task.due_date&.strftime('%B %d, %Y') || 'No due date' %>
            <% if @task.overdue? %> (OVERDUE)<% end %>
          </span>
        </p>
        <p><strong>Est. Hours:</strong> <%= @task.estimated_hours || '-' %></p>
        <p><strong>Actual Hours:</strong> <%= @task.actual_hours || '-' %></p>
        <% if @task.completed_at %>
          <p class="text-success"><strong>Completed:</strong> <%= @task.completed_at.strftime('%B %d, %Y') %></p>
        <% end %>
        <% if @task.campaign %>
          <p><strong>Campaign:</strong> <%= link_to @task.campaign.name, campaign_path(@task.campaign) %></p>
        <% end %>
      </div>
    </div>
  </div>
</div>
