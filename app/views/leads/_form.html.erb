<%= form_for @lead do |f| %>
  <% if @lead.errors.any? %>
    <div class="alert alert-danger">
      <% @lead.errors.full_messages.each do |msg| %><p><%= msg %></p><% end %>
    </div>
  <% end %>
  <div class="row">
    <div class="col-md-4"><div class="form-group"><label>Name *</label><%= f.text_field :name, class: 'form-control' %></div></div>
    <div class="col-md-4"><div class="form-group"><label>Email</label><%= f.email_field :email, class: 'form-control' %></div></div>
    <div class="col-md-4"><div class="form-group"><label>Phone</label><%= f.text_field :phone, class: 'form-control' %></div></div>
  </div>
  <div class="row">
    <div class="col-md-4"><div class="form-group"><label>Company</label><%= f.text_field :company, class: 'form-control' %></div></div>
    <div class="col-md-4"><div class="form-group"><label>Source</label><%= f.select :source, Lead::SOURCES.map { |s| [s.titleize, s] }, { include_blank: '-- Select --' }, class: 'form-control' %></div></div>
    <div class="col-md-4"><div class="form-group"><label>Stage</label><%= f.select :stage, Lead::STAGES.map { |s| [s.titleize, s] }, {}, class: 'form-control' %></div></div>
  </div>
  <div class="row">
    <div class="col-md-3"><div class="form-group"><label>Value</label><div class="input-group"><span class="input-group-addon">$</span><%= f.number_field :value, class: 'form-control', step: '0.01' %></div></div></div>
    <div class="col-md-3"><div class="form-group"><label>Score (0-100)</label><%= f.number_field :score, class: 'form-control', min: 0, max: 100 %></div></div>
    <div class="col-md-3"><div class="form-group"><label>Expected Close</label><%= f.date_field :expected_close_date, class: 'form-control' %></div></div>
    <div class="col-md-3"><div class="form-group"><label>Assigned To</label><%= f.collection_select :assigned_to_id, User.order(:first_name), :id, :full_name, { include_blank: '-- Select --' }, class: 'form-control' %></div></div>
  </div>
  <div class="row">
    <div class="col-md-6"><div class="form-group"><label>Client</label><%= f.collection_select :client_id, Client.order(:company_name), :id, :company_name, { include_blank: '-- Select --' }, class: 'form-control' %></div></div>
    <div class="col-md-6"><div class="form-group"><label>Campaign</label><%= f.collection_select :campaign_id, Campaign.order(:name), :id, :name, { include_blank: '-- Select --' }, class: 'form-control' %></div></div>
  </div>
  <div class="form-group"><label>Notes</label><%= f.text_area :notes, class: 'form-control', rows: 3 %></div>
  <%= f.submit class: 'btn btn-primary' %>
  <%= link_to 'Cancel', leads_path, class: 'btn btn-default' %>
<% end %>
