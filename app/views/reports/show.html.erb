<div class="row">
  <div class="col-md-8">
    <h2><i class="fa fa-bar-chart"></i> <%= @report.title %>
      <%= status_badge(@report.status, @report.status_color) %>
    </h2>
    <p class="text-muted">
      <%= @report.report_type&.titleize %> Report |
      Client: <%= link_to @report.client&.company_name, client_path(@report.client) if @report.client %> |
      Period: <%= @report.period_start&.strftime('%b %d') %> - <%= @report.period_end&.strftime('%b %d, %Y') %>
    </p>
  </div>
  <div class="col-md-4 text-right" style="padding-top: 20px;">
    <%= link_to raw('<i class="fa fa-edit"></i> Edit'), edit_report_path(@report), class: 'btn btn-default' %>
  </div>
</div>
<hr>

<% if @report.client %>
  <!-- Client Performance Summary -->
  <div class="row">
    <div class="col-md-3">
      <div class="panel panel-primary text-center">
        <div class="panel-body">
          <h3 style="margin:0;"><%= @report.client.active_campaigns_count %></h3>
          <small>Active Campaigns</small>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="panel panel-success text-center">
        <div class="panel-body">
          <h3 style="margin:0;"><%= number_to_currency(@report.client.campaigns.sum(:revenue), precision: 0) %></h3>
          <small>Total Revenue</small>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="panel panel-info text-center">
        <div class="panel-body">
          <h3 style="margin:0;"><%= @report.client.total_leads %></h3>
          <small>Total Leads</small>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="panel panel-warning text-center">
        <div class="panel-body">
          <h3 style="margin:0;"><%= @report.client.won_leads %></h3>
          <small>Won Leads</small>
        </div>
      </div>
    </div>
  </div>
<% end %>

<div class="panel panel-default">
  <div class="panel-heading"><h4 style="margin:0;">Report Summary</h4></div>
  <div class="panel-body">
    <%= simple_format(@report.summary) if @report.summary.present? %>
    <p class="text-muted" if @report.summary.blank?>No summary written yet.</p>
  </div>
</div>

<p class="text-muted">
  Generated by: <%= @report.generated_by&.full_name %> on <%= @report.created_at.strftime('%B %d, %Y') %>
</p>
