<div class="row" style="margin-bottom: 20px;">
  <div class="col-md-6">
    <h2><i class="fa fa-bar-chart"></i> Reports</h2>
  </div>
  <div class="col-md-6 text-right" style="padding-top: 20px;">
    <%= link_to raw('<i class="fa fa-plus"></i> New Report'), new_report_path, class: 'btn btn-primary' %>
  </div>
</div>

<div class="table-responsive">
  <table class="table table-hover">
    <thead><tr><th>Title</th><th>Type</th><th>Client</th><th>Period</th><th>Status</th><th>Generated By</th><th>Created</th><th></th></tr></thead>
    <tbody>
      <% @reports.each do |report| %>
        <tr>
          <td><%= link_to report.title, report_path(report) %></td>
          <td><%= report.report_type&.titleize %></td>
          <td><%= report.client&.company_name %></td>
          <td><%= report.period_start&.strftime('%b %d') %> - <%= report.period_end&.strftime('%b %d, %Y') %></td>
          <td><%= status_badge(report.status, report.status_color) %></td>
          <td><%= report.generated_by&.full_name %></td>
          <td><%= report.created_at.strftime('%b %d, %Y') %></td>
          <td><%= link_to raw('<i class="fa fa-edit"></i>'), edit_report_path(report), class: 'btn btn-xs btn-default' %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
