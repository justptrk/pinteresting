<h2><i class="fa fa-users"></i> Team Members</h2>
<hr>
<div class="row">
  <% @users.each do |user| %>
    <div class="col-md-3">
      <div class="panel panel-default text-center">
        <div class="panel-body">
          <div style="width: 60px; height: 60px; border-radius: 50%; background: #0f3460; color: white; font-size: 24px; line-height: 60px; margin: 0 auto 10px;">
            <%= user.initials %>
          </div>
          <h4><%= link_to user.full_name, user_path(user) %></h4>
          <p class="text-muted"><%= user.title || user.role.titleize %></p>
          <span class="label label-primary"><%= user.role.titleize %></span>
        </div>
      </div>
    </div>
  <% end %>
</div>
