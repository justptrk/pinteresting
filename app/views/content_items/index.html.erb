<div class="row" style="margin-bottom: 20px;">
  <div class="col-md-6">
    <h2><i class="fa fa-pencil-square-o"></i> Content</h2>
  </div>
  <div class="col-md-6 text-right" style="padding-top: 20px;">
    <%= link_to raw('<i class="fa fa-calendar"></i> Calendar View'), calendar_content_items_path, class: 'btn btn-default' %>
    <%= link_to raw('<i class="fa fa-plus"></i> New Content'), new_content_item_path, class: 'btn btn-primary' %>
  </div>
</div>

<div class="btn-group" style="margin-bottom: 15px;">
  <%= link_to 'All', content_items_path, class: "btn btn-default btn-sm #{params[:status].blank? ? 'active' : ''}" %>
  <% ContentItem::STATUSES.each do |s| %>
    <%= link_to s.titleize, content_items_path(status: s), class: "btn btn-default btn-sm #{params[:status] == s ? 'active' : ''}" %>
  <% end %>
</div>

<div class="table-responsive">
  <table class="table table-hover">
    <thead>
      <tr><th>Title</th><th>Type</th><th>Platform</th><th>Client</th><th>Campaign</th><th>Status</th><th>Scheduled</th><th>Assigned To</th></tr>
    </thead>
    <tbody>
      <% @content_items.each do |ci| %>
        <tr class="<%= 'danger' if ci.overdue? %>">
          <td><%= link_to ci.title, content_item_path(ci) %></td>
          <td><%= ci.content_type_label %></td>
          <td><i class="fa fa-<%= ci.platform_icon %>"></i> <%= ci.platform&.titleize %></td>
          <td><%= ci.client&.company_name %></td>
          <td><%= ci.campaign&.name %></td>
          <td><%= status_badge(ci.status, ci.status_color) %></td>
          <td><%= ci.scheduled_at&.strftime('%b %d, %I:%M %p') %></td>
          <td><%= ci.assigned_to&.full_name %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
