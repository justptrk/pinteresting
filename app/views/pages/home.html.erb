<div class="jumbotron text-center" style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%); color: white; padding: 80px 20px; margin-top: -20px;">
  <div style="margin-bottom: 10px;">
    <svg width="80" height="80" viewBox="0 0 100 100">
      <defs>
        <linearGradient id="hg" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" style="stop-color:#00d4ff"/>
          <stop offset="50%" style="stop-color:#7b2ff7"/>
          <stop offset="100%" style="stop-color:#ff2d95"/>
        </linearGradient>
      </defs>
      <circle cx="50" cy="50" r="48" fill="none" stroke="url(#hg)" stroke-width="3"/>
      <circle cx="50" cy="50" r="38" fill="none" stroke="url(#hg)" stroke-width="1.5" opacity="0.5"/>
      <path d="M30 65 L30 35 L50 35 Q62 35 62 47 Q62 58 50 58 L30 58" fill="none" stroke="url(#hg)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="72" cy="35" r="4" fill="#00d4ff"/>
      <circle cx="72" cy="50" r="3" fill="#7b2ff7"/>
      <circle cx="72" cy="65" r="2" fill="#ff2d95"/>
    </svg>
  </div>
  <h1 style="font-size: 48px; font-weight: 700;">Pajo Digital Marketing</h1>
  <p style="font-size: 22px; margin-top: 20px; opacity: 0.9;">The All-in-One Digital Marketing Platform for Agencies</p>
  <p style="font-size: 16px; opacity: 0.7; max-width: 600px; margin: 20px auto;">
    Manage clients, campaigns, content, leads, and analytics — all from one powerful dashboard.
  </p>
  <div style="margin-top: 40px;">
    <%= link_to 'Get Started Free', sign_up_path, class: 'btn btn-primary btn-lg', style: 'padding: 15px 40px; font-size: 18px; border-radius: 30px;' %>
    <%= link_to 'Sign In', sign_in_path, class: 'btn btn-default btn-lg', style: 'padding: 15px 40px; font-size: 18px; border-radius: 30px; margin-left: 10px;' %>
  </div>
</div>

<div class="container" style="margin-top: 60px;">
  <div class="row">
    <div class="col-md-4 text-center" style="padding: 30px;">
      <i class="fa fa-building fa-3x" style="color: #0f3460;"></i>
      <h3>Client Management</h3>
      <p>Full CRM to manage client relationships, contracts, and account details.</p>
    </div>
    <div class="col-md-4 text-center" style="padding: 30px;">
      <i class="fa fa-bullhorn fa-3x" style="color: #0f3460;"></i>
      <h3>Campaign Tracking</h3>
      <p>Monitor campaigns across SEO, PPC, Social, Email. Track budgets, spend, and ROI.</p>
    </div>
    <div class="col-md-4 text-center" style="padding: 30px;">
      <i class="fa fa-calendar fa-3x" style="color: #0f3460;"></i>
      <h3>Content Calendar</h3>
      <p>Plan, schedule, and publish content across all platforms with a visual calendar.</p>
    </div>
  </div>
  <div class="row">
    <div class="col-md-4 text-center" style="padding: 30px;">
      <i class="fa fa-users fa-3x" style="color: #0f3460;"></i>
      <h3>Lead Pipeline</h3>
      <p>Track leads from first touch to close with visual pipeline and scoring.</p>
    </div>
    <div class="col-md-4 text-center" style="padding: 30px;">
      <i class="fa fa-tasks fa-3x" style="color: #0f3460;"></i>
      <h3>Task Management</h3>
      <p>Assign and track tasks with priority-based workflow and due dates.</p>
    </div>
    <div class="col-md-4 text-center" style="padding: 30px;">
      <i class="fa fa-bar-chart fa-3x" style="color: #0f3460;"></i>
      <h3>Analytics & Reports</h3>
      <p>Generate client reports, track KPIs, and prove ROI.</p>
    </div>
  </div>
</div>

<div style="background-color: #f5f5f5; padding: 60px 0; margin-top: 60px;">
  <div class="container text-center">
    <h2>Ready to Supercharge Your Agency?</h2>
    <p style="font-size: 18px; color: #777;">Join marketing teams who use Pajo to manage everything in one place.</p>
    <%= link_to 'Start Free Today', sign_up_path, class: 'btn btn-primary btn-lg', style: 'padding: 15px 50px; border-radius: 30px;' %>
  </div>
</div>
