<!-- BAKERY MODAL -->
<div class="modal-overlay" id="bakery-modal">
  <div class="modal bakery-theme">
    <button class="modal-close" onclick="closeModal('bakery-modal')">&times;</button>
    <h2>&#127850; Gingerbread Bakery</h2>
    <div class="modal-content">
      <p>Mrs. Claus's famous gingerbread cookies! Click to decorate:</p>
      <div class="cookie-decorator">
        <div class="cookie-canvas" id="cookie-canvas">
          <div class="gingerbread-man">
            <div class="gb-head"></div>
            <div class="gb-body"></div>
            <div class="gb-arm left"></div>
            <div class="gb-arm right"></div>
            <div class="gb-leg left"></div>
            <div class="gb-leg right"></div>
            <div class="gb-decorations" id="gb-decorations"></div>
          </div>
        </div>
