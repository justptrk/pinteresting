<div class="row" style="margin-top: 50px;">
  <div class="col-md-4 col-md-offset-4">
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title text-center">Sign In to Pajo</h3>
      </div>
      <div class="panel-body">
        <%= form_tag sessions_path, method: :post do %>
          <div class="form-group">
            <label>Email</label>
            <%= text_field_tag :email, nil, class: 'form-control', placeholder: 'you@company.com', autofocus: true %>
          </div>
          <div class="form-group">
            <label>Password</label>
            <%= password_field_tag :password, nil, class: 'form-control' %>
          </div>
          <%= submit_tag 'Sign In', class: 'btn btn-primary btn-block btn-lg' %>
        <% end %>
      </div>
      <div class="panel-footer text-center">
        Don't have an account? <%= link_to 'Sign up', sign_up_path %>
      </div>
    </div>
  </div>
</div>
